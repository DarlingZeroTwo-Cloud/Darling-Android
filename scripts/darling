#!/bin/bash
# Darling Android - 主命令
# 用法: darling install <apk文件>

DARLING_ANDROID_DIR="/opt/darling-android"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

info() { echo -e "${GREEN}[INFO]${NC} $1"; }
warn() { echo -e "${YELLOW}[WARN]${NC} $1"; }
error() { echo -e "${RED}[ERROR]${NC} $1"; }

# 安装 APK
install_apk() {
    local apk_file="$1"
    
    if [ ! -f "$apk_file" ]; then
        error "APK 文件不存在: $apk_file"
        exit 1
    fi
    
    info "安装 APK: $apk_file"
    
    # 复制 APK 到 Android 数据目录
    cp "$apk_file" "$DARLING_ANDROID_DIR/data/app/"
    
    info "安装完成！"
    info "运行: darling run <包名>"
}

# 运行应用
run_app() {
    local package_name="$1"
    
    if [ -z "$package_name" ]; then
        error "请指定包名"
        exit 1
    fi
    
    info "运行应用: $package_name"
    # TODO: 实现应用启动
}

# 主函数
main() {
    case "$1" in
        install)
            install_apk "$2"
            ;;
        run)
            run_app "$2"
            ;;
        *)
            echo "Darling Android - 在 Linux 上运行 Android 应用"
            echo ""
            echo "用法:"
            echo "  darling install <apk文件>    安装 APK"
            echo "  darling run <包名>           运行应用"
            echo "  darling --help              显示帮助"
            exit 1
            ;;
    esac
}

main "$@"
